# Zuoya GMK87: USB cable 320f:5055, 2.4G dongle (Telink) 320f:5088.
# Gives the logged-in user access to the keyboard's hidraw nodes, so GMK87 Control runs without sudo.
KERNEL=="hidraw*", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5055", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5088", MODE="0660", TAG+="uaccess"
